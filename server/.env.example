# --- Database (Neon PostgreSQL) ---
# Pooled connection string used by the running app
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
# Direct (non-pooled) connection used by `prisma migrate deploy`. Optional locally.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# --- Auth ---
# Long random string, e.g. `openssl rand -hex 48`
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
BCRYPT_ROUNDS=12

# --- HTTP ---
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed frontend origins (your Vercel URL in production)
CORS_ORIGIN="http://localhost:5173"
# Max Excel upload size in megabytes
MAX_UPLOAD_MB=10
